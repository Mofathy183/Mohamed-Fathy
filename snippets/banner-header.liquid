{% comment %}
  snippets/banner-header.liquid
  Global header: wordmark, tagline, "CHOOSE GIFT" button, and the mobile
  hamburger/X toggle. Styling lives in banner.liquid's {% style %} block
  (snippets can't use {% style %}); toggle behavior is wired in
  gift-guide.js via initMobileHeaderToggle().

  Expects: `section` (render 'banner-header', section: section)
{% endcomment %}
<div class="banner__header">
  <div class="banner__content">
      <span class="banner__wordmark">{{ section.settings.wordmark }}</span>

      {%- comment %} Mobile-only hamburger/X toggle, hidden on desktop via CSS. {% endcomment -%}
      <button
      type="button"
      class="banner__nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="BannerHeaderExpand-{{ section.id }}"
      aria-label="Toggle menu"
    >
      <span class="banner__nav-icon-open">{% render 'icon-hamburger' %}</span>
      <span class="banner__nav-icon-close">{% render 'icon-close' %}</span>
    </button>

    {%- comment %}
      Desktop: display:contents dissolves this wrapper so tagline and CTA
      become direct children of the header's 3-column grid, centering the
      tagline independent of button width. Mobile: becomes a real flex
      column, toggled by initMobileHeaderToggle() via data-expanded.
    {%- endcomment -%}
    <div class="banner__header-expand" id="BannerHeaderExpand-{{ section.id }}" data-nav-expand>
      <p class="banner__tagline">{{ section.settings.tagline }}</p>
      <div class="banner__cta-group">
        <a href="{{ section.settings.header_button_link | default: '#' }}" class="banner__button banner__button--yellow">
          {{ section.settings.header_button_label }} {% render 'icon-arrow' %}
        </a>
      </div>
    </div>
  </div>
</div>
