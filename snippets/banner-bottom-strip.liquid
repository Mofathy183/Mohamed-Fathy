{% comment %}
  snippets/banner-bottom-strip.liquid
  Full-width strip below the Banner hero.
  Desktop and mobile use separate settings (not one truncated string) —
  Figma confirms distinct copy per breakpoint. Visibility toggled via CSS
  at the standard 480px breakpoint.

  Expects: `section` (render 'banner-bottom-strip', section: section)
{% endcomment %}
<div class="banner__bottom-strip">
  <p class="banner__bottom-strip-text banner__bottom-strip-text--desktop">{{ section.settings.bottom_strip_text }}</p>
  <p class="banner__bottom-strip-text banner__bottom-strip-text--mobile">{{ section.settings.bottom_strip_text_mobile }}</p>
</div>
