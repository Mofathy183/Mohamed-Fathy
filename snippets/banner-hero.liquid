{% comment %}
  snippets/banner-hero.liquid
  Hero content: heading, description (desktop/mobile variants),
  illustration, and the "SHOP NOW" button.

  Illustration: desktop uses a CSS background-image on .banner__hero
  (styling in banner.liquid); mobile renders a real <img> instead so
  the illustration behaves as a normal layout element in the stacked
  mobile hero. Both markup blocks always render — CSS hides whichever
  doesn't apply per breakpoint.

  Expects: `section` (render 'banner-hero', section: section)
{% endcomment %}
<div class="banner__hero">
  <div class="banner__content">
    <div class="banner__hero-text">
      <h1 class="banner__heading">{{ section.settings.heading }}</h1>
      <div class="banner__description banner__description--desktop">{{ section.settings.description }}</div>
      <div class="banner__description banner__description--mobile">{{ section.settings.description_mobile }}</div>
    </div>

    <div class="banner__hero-illustration">
      {%- comment %}
        Mobile-only <img>; hidden on desktop. width/height are the SVG's
        intrinsic dimensions (theme-check's ImgWidthAndHeight) — CSS still
        forces width:100%/height:auto at render time.
      {%- endcomment -%}
      <img
        src="{{ 'banner-illustration-mobile.svg' | asset_url }}"
        alt=""
        role="presentation"
        loading="lazy"
        width="800"
        height="600"
        class="banner__hero-illustration-image"
      >

      <a href="{{ section.settings.banner_button_link | default: '#' }}" class="banner__button banner__button--black">
        {{ section.settings.banner_button_label }} {% render 'icon-arrow' %}
      </a>
    </div>
  </div>
</div>
