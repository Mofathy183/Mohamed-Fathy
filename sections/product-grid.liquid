{% comment %}
  sections/product-grid.liquid
  "Tisso vison in the wild" product grid — 6 merchant-selectable
  products (product-picker blocks), 3-col desktop / stacked mobile.
  Built from scratch (no Dawn section reuse).

  Tile content: per the Figma preview, a tile is just the product photo
  plus a circular "+" popup-trigger marker — name, price, description,
  color, size, and Add to Cart all live in the popup snippet instead.

  Popup architecture: each tile's popup renders inside that tile's own
  .product-grid__image-wrap (the same position:relative container the
  hotspot marker uses) and is positioned as a fixed, centered modal via
  gift-guide.css. Every product owns exactly one popup instance, scoped
  to its own id.

  Depends on:
    - assets/gift-guide.css
    - assets/gift-guide.js (Phase 4: color/size selection, add-to-cart,
      and the Black/Medium → Soft Winter Jacket cross-sell — scoped to
      the popup). The <script> tag is loaded once from
      sections/banner.liquid, since Banner always renders first.
    - snippets/product-popup.liquid (rendered per tile; owns all product
      detail markup and its own embedded [data-product-json] tag)

  Schema limitation: resource-reference settings (`product`,
  `collection`, `page`, etc.) can't carry a `default` value, so the six
  confirmed handles below can't be wired in as literal schema defaults.
  Fix: `presets` pre-creates 6 empty product blocks so the section looks
  right on first add, and the Liquid loop below falls back to
  `all_products['<handle>']` for any block a merchant hasn't picked yet.
  Note: when this section is placed via a JSON template
  (templates/page.gift-guide.json), the template's own blocks/
  block_order populate section.blocks — presets only fire when a
  merchant adds the section fresh from the customizer.

  Hotspot positioning: hotspot_x/hotspot_y are per-block settings
  (percentage of that tile's own image box), rendered as CSS custom
  properties consumed by an absolutely-positioned marker inside a
  position:relative image wrapper — the browser handles scaling at
  every breakpoint with no JS/pixel math. Defaults below were derived
  from each marker's Figma position relative to its own 433×444 image
  box (e.g. 256.5/433 ≈ 59%, 238/444 ≈ 54%).
{% endcomment %}

{%- assign fallback_handles = "olive-green-jacket,chequered-red-shirt,classic-leather-jacket,striped-silk-blouse,yellow-wool-jumper,classic-varsity-top" | split: ',' -%}

<section class="product-grid__section section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="product-grid">

  <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>

  {%- comment %}
    Hidden cross-sell data embed. Soft Winter Jacket (handle:
    dark-winter-jacket) is deliberately not one of the 6 visible grid
    products — showing it directly would undercut the "hidden" part of
    the Black+Medium cross-sell rule. Its variants/options are embedded
    once at the section level (not per-tile) so gift-guide.js can
    resolve its matching variant client-side with no extra network
    call. Renders no visible UI.
  {%- endcomment -%}
  {%- assign cross_sell_product = all_products['dark-winter-jacket'] -%}
  {%- if cross_sell_product != blank -%}
    <script type="application/json" data-cross-sell-variants="{{ cross_sell_product.handle }}">
      {{ cross_sell_product.variants | json }}
    </script>
    <script type="application/json" data-cross-sell-options="{{ cross_sell_product.handle }}">
      {{ cross_sell_product.options | json }}
    </script>
  {%- endif -%}

  <div class="product-grid__tiles">
    {%- for block in section.blocks -%}
      {%- assign grid_product = block.settings.product -%}

      {%- if grid_product == blank -%}
        {%- comment %} No merchant selection yet — fall back to the confirmed default handle for this slot. {% endcomment -%}
        {%- assign fallback_handle = fallback_handles[forloop.index0] -%}
        {%- assign grid_product = all_products[fallback_handle] -%}
      {%- endif -%}

      {%- if grid_product == blank or grid_product == empty -%}
        {%- comment %} Neither a merchant pick nor a valid fallback exists — render a clean placeholder instead of breaking the grid. {% endcomment -%}
        <div class="product-grid__tile product-grid__tile--empty" {{ block.shopify_attributes }}>
          <p class="product-grid__placeholder-text">Select a product in the theme customizer</p>
        </div>
      {%- else -%}
        {%- comment %}
          Resolve hotspot_x/hotspot_y to a guaranteed numeric value
          (default: 50). If either were ever nil, the inline
          `--hotspot-x: %;` custom property would be invalid, and an
          invalid custom property makes left/top resolve to `auto`
          rather than falling through to var()'s fallback — which drops
          the marker out of its pinned position into normal flow.
        {%- endcomment -%}
        {%- assign hotspot_x = block.settings.hotspot_x | default: 50 -%}
        {%- assign hotspot_y = block.settings.hotspot_y | default: 50 -%}

        <div
          class="product-grid__tile"
          data-product-id="{{ grid_product.id }}"
          data-product-handle="{{ grid_product.handle }}"
          {{ block.shopify_attributes }}
        >
          {%- comment %}
            Photo + popup trigger marker only. Positioning: hotspot_x/y
            are percentages of this image's own box, set as CSS custom
            properties consumed by .product-grid__popup-trigger (see
            {% style %} below) — the marker stays pinned to the same
            point on the photo at every breakpoint with zero JS.
          {%- endcomment -%}
          <div class="product-grid__image-wrap">
            {%- if grid_product.featured_image != blank -%}
              <img
                src="{{ grid_product.featured_image | image_url: width: 900 }}"
                alt="{{ grid_product.featured_image.alt | default: grid_product.title | escape }}"
                loading="lazy"
                width="900"
                height="{{ 900 | divided_by: grid_product.featured_image.aspect_ratio }}"
                class="product-grid__image"
              >
            {%- endif -%}
            <button
              type="button"
              class="product-grid__popup-trigger"
              data-popup-target="popup-{{ grid_product.id }}"
              aria-label="View {{ grid_product.title | escape }} details"
              style="--hotspot-x: {{ hotspot_x }}%; --hotspot-y: {{ hotspot_y }}%;"
            >
              {%- render 'icon-plus' -%}
            </button>

            {%- comment %}
              Rendered inside .product-grid__image-wrap so the popup
              stays visually attached to its own product's image at
              every breakpoint. Each tile owns exactly one popup
              instance, scoped to its own product id.
            {%- endcomment -%}
            {%- render 'product-popup', product: grid_product -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% style %}
  .section-{{ section.id }} {
    padding: 4rem 2rem;
  }
  .product-grid__heading {
    font-family: 'Lustria', serif;
    font-weight: 400;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1.2; 
    text-align: left;
    margin: 0 0 1.875rem;
  }
  .product-grid__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 1339px;
    margin: 0 auto;
  }

  .product-grid__tile {
    width: auto; 
  }
  
  /* Anchor for the absolutely-positioned hotspot below — resolves
    hotspot_x/hotspot_y percentages against the image's own box. */
  .product-grid__image-wrap,
  .product-grid__image {
    width: 100%;
    aspect-ratio: 433 / 444; 
    height: auto;
    object-fit: cover;
  }

  /* Hotspot "+" marker — 20x20 circle, position driven entirely by the
    --hotspot-x/--hotspot-y custom properties set inline per block.
    translate(-50%, -50%) centers the circle ON the percentage point. */
  .product-grid__popup-trigger {
    position: absolute;
    left: var(--hotspot-x, 50%);
    top: var(--hotspot-y, 50%);
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(248, 248, 248, 0.9);
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 2;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
  .product-grid__popup-trigger .icon-plus {
    width: 8px;
    height: 8px;
    display: block;
    pointer-events: none;
  }
  .product-grid__popup-trigger:hover,
  .product-grid__popup-trigger:focus-visible {
    background: #ffffff;
  }

  .product-grid__tile--empty {
    border: 1px dashed #ccc;
    padding: 2rem;
    text-align: center;
  }

  /* Note: tiles are image-only now, so the 2-column "in the wild"
    gallery and the single-column tile layout read as the same content
    at two breakpoints rather than two different pieces of content —
    implemented as a wider tier (2 columns) and a narrow 402px tier
    (1 column, matching Figma's Frame 1). Re-check against the Figma
    mobile frames before final submission. */
  @media (max-width: 768px) {
    .section-{{ section.id }} {
      padding: 1.5rem 1rem;
    }
    .product-grid__heading {
      margin: 0 0 1rem;
    }
    .product-grid__tiles {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    /* Reset desktop's fixed sizing so the 2-col grid tracks control width. */
    .product-grid__tile,
    .product-grid__image-wrap {
      width: auto;
      height: auto;
    }
    .product-grid__image {
      width: 100%;
      aspect-ratio: 169 / 186.42;
      height: auto;
      object-fit: cover;
    }
  }
  @media (max-width: 480px) {
    .product-grid__heading {
      text-align: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Pick a product to populate this grid slot. If left unset, one of the six confirmed products is used as a fallback."
        },
        {
          "type": "header",
          "content": "Popup marker position"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "info": "Percentage across this block's image, left to right."
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "info": "Percentage down this block's image, top to bottom."
        },
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        { "type": "product", "settings": { "hotspot_x": 62, "hotspot_y": 57 } },
        { "type": "product", "settings": { "hotspot_x": 85, "hotspot_y": 53 } },
        { "type": "product", "settings": { "hotspot_x": 64, "hotspot_y": 21 } },
        { "type": "product", "settings": { "hotspot_x": 73, "hotspot_y": 20 } },
        { "type": "product", "settings": { "hotspot_x": 49, "hotspot_y": 26 } },
        { "type": "product", "settings": { "hotspot_x": 77, "hotspot_y": 40 } }
      ]
    }
  ]
}
{% endschema %}
