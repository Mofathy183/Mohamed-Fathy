{% comment %}
  sections/banner.liquid
  Orchestrates the Banner section: header, hero, and bottom strip, each
  rendered from its own snippet. Owns the {% schema %} and all
  section-scoped CSS (the {% style %} tag only works in sections, so
  styling for the snippets below stays centralized here).

    snippets/banner-header.liquid       → wordmark / tagline / CHOOSE GIFT / mobile toggle
    snippets/banner-hero.liquid         → heading / description / illustration / SHOP NOW
    snippets/banner-bottom-strip.liquid → the strip

  Built from scratch (no Dawn section reuse). All copy is
  customizer-editable via schema settings.

  Depends on:
    - assets/gift-guide.js  → initMobileHeaderToggle() wires the mobile
      hamburger/X toggle.
    - assets/gift-guide.css → shared/reset rules; section-specific
      styling lives in the {% style %} block below.

  Type scaling: Figma's desktop values (164.78px heading / 47.08px
  description) come from a 3,840px artboard that's likely a 2x+ export
  canvas, not the literal browser width. Heading/description sizing
  below uses clamp() scaled toward the ~1920px-reference numbers
  instead of the literal artboard pixels — verify against the live page
  and adjust if needed.

  Illustration: desktop and mobile use two separate SVG exports (not one
  asset reused), shipped as static theme assets referenced via
  asset_url. Desktop renders its SVG as a CSS background-image on
  .banner__hero; mobile renders a real <img> instead, since the stacked
  mobile layout needs the illustration as a real layout element.
{% endcomment %}

<section class="banner__section section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="banner">
  {%- render 'banner-header', section: section -%}
  {%- render 'banner-hero', section: section -%}
  {%- render 'banner-bottom-strip', section: section -%}
</section>

{%- comment %}
  Loaded once here since Banner always renders first on the Gift Guide
  page (templates/page.gift-guide.json) — avoids a second load from
  product-grid.liquid or product-popup.liquid.
{% endcomment -%}
<link rel="stylesheet" href="{{ 'gift-guide.css' | asset_url }}">
<script src="{{ 'gift-guide.js' | asset_url }}" type="module"></script>

{% style %}
  .section-{{ section.id }} {
    background: #ffffff;
  }

  /* Header bar */
  .banner__header {
    background: #f5f5f5;
    padding: 1.75rem 2.5rem;
  }
  /* .banner__content is shared with the hero, so the grid layout is
    scoped to .banner__header to avoid affecting the hero's use of the
    same class. */
  @media (min-width: 481px) {
    .banner__header .banner__content {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      width: 100%;
      max-width: none;
      column-gap: 2rem;
    }
  }
  .banner__wordmark {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    justify-self: start;
  }
  .banner__tagline {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    color: #000000;
    justify-self: center;
    margin: 0;
  }
  .banner__content {
    max-width: 560px;
    position: relative;
    z-index: 1;
  }
  /* Desktop: dissolves the wrapper so tagline/CTA become direct grid
    items of the header row, centering independently of button width. */
  .banner__header-expand {
    display: contents;
  }
  .banner__header-inner {
    width: 100%;
  }
  .banner__tagline {
    white-space: nowrap;
  }
  .banner__cta-group {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .banner__nav-toggle {
    display: none; /* shown only in the mobile breakpoint below */
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0;
  }
  .banner__nav-icon-close { display: none; }
  .banner__nav-toggle[aria-expanded="true"] .banner__nav-icon-open { display: none; }
  .banner__nav-toggle[aria-expanded="true"] .banner__nav-icon-close { display: inline; }

  .banner__cta-group .banner__button--yellow {
    width: 180px;
    height: 48px;
  }

  /* Buttons */
  .icon-arrow {
    vertical-align: middle;
    margin-left: 0.5em;
    transition: color 300ms ease-out;
  }

  .banner__button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 244px;
    height: 44px;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    transition: color 300ms ease-out;
  }
  .banner__button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 300ms ease-out;
  }
  .banner__button:hover::before,
  .banner__button:focus-visible::before {
    transform: scaleX(1);
    transform-origin: left center;
  }
  .banner__button--yellow { background: #fff544; color: #000000; }
  .banner__button--yellow::before { background: #000000; }
  .banner__button--yellow:hover,
  .banner__button--yellow:focus-visible { color: #fff544; }

  .banner__button--black { background: #000000; color: #ffffff; }
  .banner__button--black::before { background: #fff544; }
  .banner__button--black:hover,
  .banner__button--black:focus-visible { color: #000000; }

  /* Hero */
  .banner__hero {
    position: relative;
    /* no more artificial min-height or aspect-ratio lock — the box grows
      from real content, and the paddings below reserve exactly the
      right amount of room for each illustration layer, scaling with
      width the same way the layers themselves do. */
    padding-top: 30%;     /* clears the top strip: 1065/3840 = 27.7%, +~2% breathing room */
    padding-bottom: 4rem; /* just breathing room above the bottom strip section — not illustration-related, so a plain rem value is fine here */
    padding-left: 4rem;
    padding-right: 4rem;
    display: block;
    overflow: hidden;
  }

  .banner__hero-illustration-layer {
    position: absolute;
    background-repeat: no-repeat;
    background-size: 100% auto;
    pointer-events: none;
    z-index: 0;
  }

  .banner__hero-illustration-layer--top {
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 3840 / 1065;
    background-image: url('{{ "banner-illustration-top.svg" | asset_url }}');
    background-position: top left;
  }

  .banner__hero-illustration-layer--bottom {
    bottom: 0; /* literal value, not a %, so it's immune to the height-vs-width mismatch */
    right: 0;
    width: 61.82%;
    aspect-ratio: 2374 / 1072;
    background-image: url('{{ "banner-illustration-bottom.svg" | asset_url }}');
    background-position: bottom right;
  }


  .banner__content {
    max-width: 560px;
    position: relative;
    z-index: 1;
  }
  .banner__heading {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: clamp(2.75rem, 4vw, 4.25rem);
    line-height: 1;
    margin: 0 0 1.25rem;
  }
  .banner__description {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.4;
    max-width: 20rem;
    margin: 0 0 1.5rem;
  }
  .banner__description--mobile {
    display: none;
  }

  .banner__illustration {
    min-width: 0;
  }
  .banner__illustration img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Desktop: dissolves both wrappers so heading/description/button act
    as direct children of .banner__content, and hides the mobile-only
    illustration <img> since desktop uses the background-image above. */
  .banner__hero-text,
  .banner__hero-illustration {
    display: contents;
  }
  .banner__hero-illustration-image {
    display: none;
  }

  /* Bottom strip */
  .banner__bottom-strip {
    width: 100%;
    text-align: center;
    text-transform: uppercase;
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    padding: 1rem;
    border-top: 1px solid #eeeeee;
  }
  .banner__bottom-strip-text {
    margin: 0;
  }
  .banner__bottom-strip-text--mobile {
    display: none;
  }

  /* Mobile — 402px fixed width (Figma Frame 1). Stacked order: header →
    heading → description → illustration (w/ SHOP NOW overlaid) →
    bottom strip. */
  @media (max-width: 480px) {
    .banner__heading {
      font-size: 1.875rem;
      line-height: 1;
      margin: 0 0 1.5rem;
    }
    .banner__description {
      font-size: 1rem;
      line-height: 1.3;
      max-width: 21.25rem;
      margin: 0 auto 1rem;
    }
    .banner__description--desktop {
      display: none;
    }
    .banner__description--mobile {
      display: block;
    }

    .banner__hero-illustration-layer {
      display: none; /* desktop-only bleed art — mobile uses its own <img> in banner-hero.liquid instead */
    }

    .banner__header .banner__content {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    .banner__nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      left: 0;
      top: 0;
      height: 2rem;
    }

    .banner__nav-icon-open svg {
      display: block;
      width: 18px;
      height: 11px;
    }
    .banner__nav-icon-close svg {
      display: block;
      width: 14px;
      height: 14px;
    }

    .banner__header-expand {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      margin-top: 1.5rem;
      flex-basis: 100%;
      width: 100%;
      text-align: center;
    }
    .banner__header-expand[data-expanded="true"] {
      display: flex;
    }

    .banner__tagline {
      justify-self: auto;
      margin: 0;
      white-space: normal;
      text-align: center;
    }

    .banner__cta-group {
      justify-self: auto;
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .banner__header-expand .banner__button {
      width: 244px;
      max-width: 85%;
      margin: 0 auto 0.75rem;
    }

    /* Hero, mobile: illustration is a real <img> (see markup) instead
      of a CSS background, so it sizes itself from its own aspect
      ratio with no min-height guesswork. .banner__content becomes a
      vertical stack: text block, then illustration block. */
    .banner__hero {
      min-height: 0;
      align-items: flex-start;
      background-image: none;
      padding: 3.0625rem 1.25rem 0;
    }
    .banner__hero .banner__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-width: none;
    }

    .banner__hero-text {
      display: block;
      width: 100%;
    }

    /* Positioned relative to this wrapper, not the whole hero, so
      SHOP NOW always sits on the image regardless of image height. */
    .banner__hero-illustration {
      display: block;
      position: relative;
      width: 100%;
      margin-top: 1.25rem;
    }
    .banner__hero-illustration-image {
      display: block;
      width: 100%;
      height: auto;
    }
    .banner__hero-illustration .banner__button {
      position: absolute;
      left: 50%;
      bottom: 2rem;
      transform: translateX(-50%);
      width: auto;
      min-width: 155px;
    }

    .banner__bottom-strip {
      margin-top: 0.5rem;
    }
    .banner__bottom-strip-text--desktop { display: none; }
    .banner__bottom-strip-text--mobile { display: block; }

    .banner__button { transition: none; }
    .banner__button::before { display: none; }
    .banner__button--yellow:hover,
    .banner__button--yellow:focus-visible { color: #000000; }
    .banner__button--black:hover,
    .banner__button--black:focus-visible { color: #ffffff; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark / logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Header tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button_label",
      "label": "Header button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Header button link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "richtext",
      "id": "description_mobile",
      "label": "Description (mobile)",
      "info": "Shown only on mobile in place of the full description.",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "text",
      "id": "banner_button_label",
      "label": "Banner button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Banner button link"
    },
    {
      "type": "text",
      "id": "bottom_strip_text",
      "label": "Bottom strip text (desktop)",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "bottom_strip_text_mobile",
      "label": "Bottom strip text (mobile)",
      "info": "Distinct from the desktop copy per the Figma mobile frame.",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
